+fn peer_certificate(verifier: &PinnedCertVerifier, der: &[u8]) -> Result<PeerCertificate, String> {
+    if der.is_empty() || der.len() > 32768 {
+        return Err("Invalid certificate size".to_string());
+    }
+    if let Some(expected) = &verifier.pinned_der {
+        if expected != der {
+            return Err("Server certificate changed".to_string());
+        }
+    }
+    if let Some(path) = &verifier.automatic_path {
+        if let Some(expected) = load_optional_pin(path)? {
+            if expected != der {
+                return Err("Server certificate changed".to_string());
+            }
+        }
+    }
+    let cert = X509::from_der(der).map_err(|err| err.to_string())?;
+    let now = openssl::asn1::Asn1Time::days_from_now(0).map_err(|err| err.to_string())?;
+    if cert.not_before() > now || cert.not_after() < now {
+        return Err("Certificate is not currently valid".to_string());
+    }
+    Ok(PeerCertificate {
+        der: der.to_vec(),
+        pkey: cert.public_key().map_err(|err| err.to_string())?,
+        automatic_path: verifier.automatic_path.clone(),
+    })
+}
