+        let before = fs::metadata(&path).unwrap().modified().unwrap();
+        assert_eq!(
+            0,
+            check_signature(
+                peer_certificate(&verifier(&path), &der).unwrap(),
+                &mut data,
+                &mut signature
+            )
+        );
+        assert_eq!(before, fs::metadata(&path).unwrap().modified().unwrap());
+        assert!(peer_certificate(&verifier(&path), &certificate().0).is_err());
+        assert_eq!(1, fs::read_dir(&dir).unwrap().count());
+        fs::remove_dir_all(dir).unwrap();
+    }
+
+    #[test]
+    fn concurrent_enrollment_cannot_duplicate_or_replace_a_pin() {
+        let dir = directory();
+        let path = dir.join("authority.pem");
+        let (der, _) = certificate();
+        std::thread::scope(|scope| {
+            let jobs: Vec<_> = (0..4)
+                .map(|_| scope.spawn(|| persist_peer(&path, &der)))
+                .collect();
+            for job in jobs {
+                job.join().unwrap().unwrap();
+            }
+        });
+        let (other, _) = certificate();
+        assert!(persist_peer(&path, &other).is_err());
+        assert_eq!(Some(der.clone()), load_optional_pin(&path).unwrap());
+        fs::remove_file(&path).unwrap();
+        let barrier = std::sync::Barrier::new(2);
+        std::thread::scope(|scope| {
+            let first = scope.spawn(|| {
+                barrier.wait();
+                persist_peer(&path, &der)
+            });
+            let second = scope.spawn(|| {
+                barrier.wait();
+                persist_peer(&path, &other)
+            });
+            let outcomes = [first.join().unwrap(), second.join().unwrap()];
+            assert_eq!(1, outcomes.iter().filter(|result| result.is_ok()).count());
+        });
+        let stored = load_optional_pin(&path).unwrap();
+        assert!(stored == Some(der) || stored == Some(other));
+        assert_eq!(1, fs::read_dir(&dir).unwrap().count());
+        fs::remove_dir_all(dir).unwrap();
+    }
+}
