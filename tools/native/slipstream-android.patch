diff --git a/crates/slipstream-ffi/build/picoquic.rs b/crates/slipstream-ffi/build/picoquic.rs
index d6bb77e..4c99130 100644
--- a/crates/slipstream-ffi/build/picoquic.rs
+++ b/crates/slipstream-ffi/build/picoquic.rs
@@ -54,6 +54,15 @@ pub(crate) fn build_picoquic(
     }
     if let Some(root) = &openssl_paths.root {
         command.env("OPENSSL_ROOT_DIR", root);
+        // CMake's Android sysroot search does not reliably select the vendored
+        // archives from a root hint alone. Bind headers and libraries to the
+        // same openssl-sys installation rather than host/system OpenSSL.
+        let lib = root.join("lib");
+        if lib.join("libcrypto.a").is_file() && lib.join("libssl.a").is_file() {
+            command.env("OPENSSL_CRYPTO_LIBRARY", lib.join("libcrypto.a"));
+            command.env("OPENSSL_SSL_LIBRARY", lib.join("libssl.a"));
+            command.env("OPENSSL_USE_STATIC_LIBS", "TRUE");
+        }
     }
     let prefer_static_openssl = cfg!(feature = "openssl-static");
     let openssl_no_vendor = env::var_os("OPENSSL_NO_VENDOR").is_some();
