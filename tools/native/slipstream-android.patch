+fn persist_peer(path: &Path, der: &[u8]) -> Result<(), String> {
+    let matches = |known: Vec<u8>| {
+        if known == der {
+            Ok(())
+        } else {
+            Err("Server certificate changed".to_string())
+        }
+    };
+    if let Some(known) = load_optional_pin(path)? {
+        return matches(known);
+    }
+    let pem = X509::from_der(der)
+        .and_then(|cert| cert.to_pem())
+        .map_err(|err| err.to_string())?;
+    let parent = path.parent().ok_or("Missing certificate directory")?;
+    static NEXT: AtomicU64 = AtomicU64::new(0);
+    let temporary = parent.join(format!(
+        ".certificate-{}-{}.tmp",
+        std::process::id(),
+        NEXT.fetch_add(1, Ordering::Relaxed)
+    ));
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&temporary).map_err(|err| err.to_string())?;
+    let result = (|| {
+        file.write_all(&pem)
+            .and_then(|_| file.sync_all())
+            .map_err(|err| err.to_string())?;
+        #[cfg(unix)]
+        {
+            use std::os::fd::AsRawFd;
+            let directory = fs::File::open(parent).map_err(|err| err.to_string())?;
+            // Android forbids hard links in app storage. Serialize first enrollment
+            // across processes, recheck the winner, then atomically rename the full file.
+            // The descriptor releases the lock automatically on return or process death.
+            loop {
+                // SAFETY: directory owns a live descriptor for the complete locked scope.
+                if unsafe { libc::flock(directory.as_raw_fd(), libc::LOCK_EX) } == 0 {
+                    break;
+                }
+                let error = std::io::Error::last_os_error();
+                if error.kind() != std::io::ErrorKind::Interrupted {
+                    return Err(error.to_string());
+                }
+            }
+            if let Some(known) = load_optional_pin(path)? {
+                return matches(known);
+            }
+            fs::rename(&temporary, path).map_err(|err| err.to_string())?;
+            directory.sync_all().map_err(|err| err.to_string())?;
+            Ok(())
+        }
+        #[cfg(not(unix))]
+        match fs::hard_link(&temporary, path) {
+            Ok(()) => Ok(()),
+            Err(err) if err.kind() == std::io::ErrorKind::AlreadyExists => {
+                matches(load_optional_pin(path)?.ok_or("Certificate disappeared")?)
+            }
+            Err(err) => Err(err.to_string()),
+        }
+    })();
+    drop(file);
+    let _ = fs::remove_file(temporary);
+    result
+}
