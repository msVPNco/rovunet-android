<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="FlatContentButtonTemplate" TargetType="Button">
    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Outline}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="RaisedButtonTemplate" TargetType="Button">
    <Grid x:Name="RootMotion" RenderTransformOrigin="0.5,0.5">
      <Border x:Name="Base" Margin="0,3,0,0" CornerRadius="13" Background="#42000000"/>
      <Border x:Name="Face" Margin="0,0,0,3" CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid><Border x:Name="Shine" CornerRadius="12" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#24FFFFFF" Offset="0"/><GradientStop Color="#06FFFFFF" Offset="0.17"/><GradientStop Color="#00000000" Offset="0.65"/></LinearGradientBrush></Border.Background></Border><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
      </Border>
    </Grid>
    <ControlTemplate.Triggers><DataTrigger Binding="{Binding Background.Color.A,RelativeSource={RelativeSource TemplatedParent}}" Value="0"><Setter TargetName="Base" Property="Visibility" Value="Collapsed"/><Setter TargetName="Shine" Property="Visibility" Value="Collapsed"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="RootMotion" Property="RenderTransform"><Setter.Value><TranslateTransform Y="2"/></Setter.Value></Setter></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="HeroPowerTemplate" TargetType="Button">
    <Grid x:Name="RootMotion" RenderTransformOrigin="0.5,0.5">
      <Border Margin="0,10,0,0" CornerRadius="90" Background="#DC0B0B21"/>
      <Border x:Name="Face" Margin="0,0,0,10" CornerRadius="90" Background="{TemplateBinding Background}" BorderThickness="2" BorderBrush="#B0FFFFFF">
        <Grid><Border CornerRadius="90"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1"><GradientStop Color="#50FFFFFF" Offset="0"/><GradientStop Color="#11FFFFFF" Offset="0.35"/><GradientStop Color="#00000000" Offset="0.65"/><GradientStop Color="#320B0825" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border Margin="5,3,5,7" CornerRadius="90" BorderThickness="1.5,2,1,0" BorderBrush="#70FFFFFF"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      </Border>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="RootMotion" Property="RenderTransform"><Setter.Value><TranslateTransform Y="4"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Ink}"/><Setter TargetName="Face" Property="BorderThickness" Value="4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>
